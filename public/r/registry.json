        {
          "path": "registry/default/tabs/tabs.tsx",
          "type": "registry:ui",
          "target": "@ui/tabs.tsx"
        }
      ]
    },
    {
      "name": "alert-dialog",
      "type": "registry:ui",
      "title": "Alert Dialog",
