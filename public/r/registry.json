{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "binhlaig-ui",
  "homepage": "https://ui.binhlaig.com",
  "items": [
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "A reusable Binhlaig UI button component.",
      "dependencies": [
        "@radix-ui/react-slot",
        "class-variance-authority"
      ],
      "files": [
        {
          "path": "registry/default/button/button.tsx",
          "type": "registry:ui",
          "target": "@ui/button.tsx"
        }
      ]
    },
    {
      "name": "card",
      "type": "registry:ui",
      "title": "Card",
      "description": "A reusable Binhlaig UI card component.",
