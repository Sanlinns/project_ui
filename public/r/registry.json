        {
          "path": "registry/default/card/card.tsx",
          "type": "registry:ui",
          "target": "@ui/card.tsx"
        }
      ]
    },
    {
      "name": "badge",
      "type": "registry:ui",
      "title": "Badge",
      "description": "A reusable Binhlaig UI badge component.",
      "dependencies": [
        "class-variance-authority"
      ],
      "files": [
        {
          "path": "registry/default/badge/badge.tsx",
          "type": "registry:ui",
          "target": "@ui/badge.tsx"
        }
      ]
    },
    {
      "name": "input",
      "type": "registry:ui",
      "title": "Input",
      "description": "A reusable Binhlaig UI input component.",
      "dependencies": [],
